generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(cuid())
  phone        String           @unique
  zaloId       String?          @unique
  name         String?
  avatarUrl    String?
  role         Role             @default(FARMER)
  isActive     Boolean          @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessionToken String?
  chatMessages ChatMessage[]
  otpRequests  OtpRequest[]
  diagnoses    PlantDiagnosis[]
  saleProfile  SaleProfile?

  parentId String? @map("parent_id")
  parent   User?   @relation("UserHierarchy", fields: [parentId], references: [id])
  children User[]  @relation("UserHierarchy")

  inventories        Inventory[]
  b2bPurchases       B2bOrder[]          @relation("B2bBuyer")
  b2bSales           B2bOrder[]          @relation("B2bSeller")
  b2cPurchases       B2cOrder[]          @relation("B2cBuyer")
  b2cSales           B2cOrder[]          @relation("B2cSeller")
  notifications      Notification[]
  agency             Agency?
  farmer             Farmer?
  mdo                Mdo?
  se                 Se?
  profile            UserProfile?
  cropChangeRequests CropChangeRequest[] @relation("CropChangeRequester")
  cropChangeReviews  CropChangeRequest[] @relation("CropChangeReviewer")
  qrScanLogs         QrScanLog[]

  @@index([phone])
  @@index([zaloId])
  @@index([role])
  @@index([parentId])
  @@map("users")
}

model Mdo {
  id           String   @id @default(cuid())
  name         String
  employeeCode String   @unique @map("employee_code")
  region       String?
  check        String?
  phone        String   @unique
  userId       String?  @unique @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([phone])
  @@map("mdo")
}

model Se {
  id           String   @id @default(cuid())
  name         String
  employeeCode String   @unique @map("employee_code")
  region       String?
  area         String?
  location     String?
  phone        String   @unique
  email        String?
  userId       String?  @unique @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([phone])
  @@map("se")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  address   String?
  notes     String?
  cropIds   String[] @map("crop_ids")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model SaleProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  region    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sale_profiles")
}

model Crop {
  id          String   @id @default(cuid())
  cropCode    String   @unique @map("crop_code")
  name        String
  category    String?
  description String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  sortOrder   Int      @default(999) @map("sort_order")

  @@map("crops")
}

model OtpRequest {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_requests")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id          String                @id @default(cuid())
  sku         String                @unique
  name        String
  slug        String                @unique
  description String?
  imageUrls   String[]
  price       Decimal               @db.Decimal(12, 2)
  unit        String                @default("kg")
  stock       Int                   @default(0)
  isActive    Boolean               @default(true)
  categoryId  String?
  tags        String[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  detail         ProductDetail?
  diagnoses      DiagnosisSuggestion[]
  category       Category?             @relation(fields: [categoryId], references: [id])
  inventories    Inventory[]
  b2bOrderItems  B2bOrderItem[]
  b2cOrderItems  B2cOrderItem[]
  qrScanLogs     QrScanLog[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ProductDetail {
  id               String   @id @default(cuid())
  productId        String   @unique @map("product_id")
  name             String
  plantCrops       String?  @map("plant_crops")
  type             String?
  ingredients      String?
  targetDiseases   String?  @map("target_diseases")
  usageInstruction String?  @map("usage_instruction")
  description      String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_details")
}

model PlantDiagnosis {
  id            String                @id @default(cuid())
  userId        String
  imageUrls     String[]
  cropType      String?
  rawAiResponse Json?
  summary       String?
  confidence    Float?
  status        DiagnosisStatus       @default(PROCESSING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  suggestions   DiagnosisSuggestion[]
  user          User                  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("plant_diagnoses")
}

model DiagnosisSuggestion {
  id          String         @id @default(cuid())
  diagnosisId String
  productId   String?
  reason      String?
  rank        Int            @default(1)
  createdAt   DateTime       @default(now())
  diagnosis   PlantDiagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  product     Product?       @relation(fields: [productId], references: [id])

  @@map("diagnosis_suggestions")
}

model Inventory {
  id         String   @id @default(cuid())
  ownerId    String   @map("owner_id")
  productId  String   @map("product_id")
  quantity   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  owner   User    @relation(fields: [ownerId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([ownerId, productId])
  @@index([ownerId])
  @@map("inventories")
}

model B2bOrder {
  id          String      @id @default(cuid())
  buyerId     String      @map("buyer_id")
  sellerId    String      @map("seller_id")
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  buyer  User           @relation("B2bBuyer", fields: [buyerId], references: [id])
  seller User           @relation("B2bSeller", fields: [sellerId], references: [id])
  items  B2bOrderItem[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@map("b2b_orders")
}

model B2bOrderItem {
  id         String  @id @default(cuid())
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  quantity   Int
  price      Decimal @db.Decimal(12, 2)

  order   B2bOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id])

  @@map("b2b_order_items")
}

model B2cOrder {
  id           String      @id @default(cuid())
  orderNumber  String      @unique @default(cuid()) @map("order_number")
  buyerId      String      @map("buyer_id")
  sellerId     String      @map("seller_id")
  totalAmount  Decimal     @map("total_amount") @db.Decimal(12, 2)
  status       OrderStatus @default(PENDING)
  note         String?
  deliveryAddr Json?       @map("delivery_addr")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  buyer         User           @relation("B2cBuyer", fields: [buyerId], references: [id])
  seller        User           @relation("B2cSeller", fields: [sellerId], references: [id])
  items         B2cOrderItem[]
  notifications Notification[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
  @@map("b2c_orders")
}

model Notification {
  id                  String    @id @default(cuid())
  recipientId         String    @map("recipient_id")
  orderId             String?   @map("order_id")
  cropChangeRequestId String?   @map("crop_change_request_id")
  type                String
  title               String
  message             String
  isRead              Boolean   @default(false) @map("is_read")
  createdAt           DateTime  @default(now()) @map("created_at")
  readAt              DateTime? @map("read_at")

  recipient         User               @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  order             B2cOrder?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cropChangeRequest CropChangeRequest? @relation(fields: [cropChangeRequestId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@index([orderId])
  @@index([cropChangeRequestId])
  @@map("notifications")
}

model CropChangeRequest {
  id               String                  @id @default(cuid())
  requesterId      String                  @map("requester_id")
  reviewerId       String                  @map("reviewer_id")
  requesterRole    Role                    @map("requester_role")
  reviewerRole     Role                    @map("reviewer_role")
  status           CropChangeRequestStatus @default(PENDING)
  currentCropIds   String[]                @map("current_crop_ids")
  requestedCropIds String[]                @map("requested_crop_ids")
  reviewerNote     String?                 @map("reviewer_note")
  reviewedAt       DateTime?               @map("reviewed_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  requester     User           @relation("CropChangeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer      User           @relation("CropChangeReviewer", fields: [reviewerId], references: [id])
  notifications Notification[]

  @@index([requesterId, status, createdAt])
  @@index([reviewerId, status, createdAt])
  @@map("crop_change_requests")
}

model B2cOrderItem {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  quantity   Int
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  order   B2cOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("b2c_order_items")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  toUserId  String?
  content   String
  mediaUrl  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([toUserId])
  @@index([createdAt])
  @@map("chat_messages")
}

enum Role {
  FARMER
  SALE
  ADMIN
  AGENCY
  SUPER_AGENT
  MDO
  SE
  BGD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum DiagnosisStatus {
  PROCESSING
  DONE
  FAILED
}

enum CropChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PlanStageDisease {
  id              String   @id @default(cuid())
  cropType        String   @map("crop_type")
  growthStage     String   @map("growth_stage")
  pestDisease     String   @map("pest_disease")
  detail          String
  severityLevel   String   @map("severity_level")
  imageUrls       String[] @map("image_urls")
  description     String
  vfcSolution     String   @map("vfc_solution")
  actionThreshold String   @map("action_threshold")
  pestDensity     String   @map("pest_density")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([cropType, growthStage])
  @@index([cropType, growthStage, pestDisease])
  @@index([cropType, growthStage, pestDisease, severityLevel])
  @@map("plan_stage_diseases")
}

model Agency {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  phone        String?
  userId       String?  @unique @map("user_id")
  taxCode      String?  @map("tax_code")
  salesman     String?
  area         String?
  address      String?
  latitude     Float
  longitude    Float
  wardProvince String?  @map("ward_province")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User?    @relation(fields: [userId], references: [id])

  @@index([latitude, longitude])
  @@index([phone])
  @@map("agencies")
}

model Farmer {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  ward       String?
  province   String?
  crop       String?
  area       Float?
  agencyCode String?  @map("agency_code")
  mdo        String?
  se         String?
  userId     String?  @unique @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([phone])
  @@map("farmers")
}

model ZaloAuthToken {
  id                    String    @id @default("default")
  accessToken           String    @map("access_token")
  refreshToken          String    @map("refresh_token")
  expiresAt             DateTime  @map("expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  enabled               Boolean   @default(true) @map("enabled")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("zalo_auth_tokens")
}

model QrScanLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  productId     String?  @map("product_id")
  code          String   @default("")
  success       Boolean  @default(true)
  scanCount     Int      @default(1) @map("scan_count")
  lastScannedAt DateTime @default(now()) @map("last_scanned_at")
  scans         Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([userId, code])
  @@index([productId])
  @@index([code])
  @@index([userId])
  @@index([lastScannedAt])
  @@index([success])
  @@map("qr_scan_logs")
}

