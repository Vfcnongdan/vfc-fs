# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/vfcfs?schema=public"

# Auth / JWT
JWT_SECRET="vfc-jwt-secret-key-change-in-production"

# Browser-Bound OTP / NestJS Auth Server
# Local: http://localhost:3002/api/v1
# Staging/Production: https://your-vfc-server.onrender.com/api/v1
# Leave empty to fallback to Next.js legacy internal routes
NEXT_PUBLIC_AUTH_SERVER_URL="http://localhost:3002/api/v1"

# ─── Google Drive Sync (Cho ca chẩn đoán lỗi / không có thuốc qua Google Apps Script Webhook) ───
ENABLE_GOOGLE_DRIVE_SYNC=true
GOOGLE_DRIVE_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"
GOOGLE_DRIVE_FOLDER_ID="ID_THU_MUC_GOOGLE_DRIVE_CUA_BAN"